{
  "language": "uz-ru-en-mixed",
  "description": "Code-switched Uzbek / Russian / English as actually spoken in urban Tashkent. Russian and English stems take Uzbek case suffixes; Latin-script Russian and Cyrillic-script Uzbek co-occur inside a single utterance. Written for a dictation-first register: lowercase, no punctuation, missing apostrophes, run-together tokens.",
  "scripts": [
    "latin",
    "cyrillic"
  ],
  "magnitude_words": [
