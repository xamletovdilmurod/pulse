  "expense_markers": [
    {
      "surface": "outcome",
      "notes": "KEY non-native usage: means expense/outgoing, mirror of 'income'. 'add outcome 12 dollars' = expense. But 'the outcome was good' is the ordinary English noun and is NOT a transaction - only treat as an expense marker in command position or immediately before an amount."
    },
    {
      "surface": "expense",
      "notes": "'add expense 50k'"
    },
    {
      "surface": "expanse",
      "notes": "very common misspelling of expense"
    },
    {
      "surface": "expence",
      "notes": "misspelling"
    },
    {
      "surface": "spent",
      "notes": "past tense, the most frequent natural marker"
    },
    {
      "surface": "spend",
      "notes": "used as past tense by non-native speakers: 'i spend 20k today'. Also future: 'will spend' = NOT a completed transaction."
    },
    {
      "surface": "spended",
      "notes": "non-native overregularised past tense"
    },
    {
      "surface": "paid",
      "notes": "'paid 250k for internet'"
    },
    {
      "surface": "pay",
      "notes": "'i need to pay' is future/intent, not a transaction"
    },
    {
      "surface": "payed",
      "notes": "misspelling of paid"
    },
    {
      "surface": "bought",
      "notes": "implies a purchased object which usually carries the category"
    },
    {
      "surface": "buy",
      "notes": "'i buy bread 8k' non-native present-for-past"
    },
    {
      "surface": "gave",
      "notes": "'gave 200k to mom' - transfer to a person, usually family or gifts"
    },
    {
      "surface": "sent",
      "notes": "'sent 1 mn to mom'"
    },
    {
      "surface": "log",
      "notes": "app command verb: 'log 20 dollars taxi'"
    },
    {
      "surface": "add",
      "notes": "app command verb, neutral - direction comes from the following word"
    },
    {
      "surface": "note",
      "notes": "'note 30k lunch'"
    },
    {
      "surface": "record",
      "notes": "app command verb"
    },
    {
      "surface": "minus",
      "notes": "'minus 50k' - direction marker with no verb"
    },
    {
      "surface": "-",
      "notes": "leading hyphen used as an outgoing marker: '-50k taxi'"
    },
    {
      "surface": "cost",
      "notes": "'it cost me 45k'"
    },
    {
      "surface": "charged",
      "notes": "'they charged me 15k'"
    },
    {
      "surface": "took",
      "notes": "'the taxi took 30k' - the subject is the service, not the user"
    },
    {
      "surface": "dropped",
      "notes": "slang: 'dropped 200 bucks on shoes'"
    },
    {
      "surface": "blew",
      "notes": "slang: 'blew 500k on nothing'"
    },
    {
      "surface": "topped up",
      "notes": "phone/card balance top-up, usually communication"
    },
    {
      "surface": "withdrew",
      "notes": "cash withdrawal, often fees rather than a real expense"
    }
  ],
