{
  "language": "en",
  "scripts": [
    "latin"
  ],
  "notes": "English as typed/spoken into a phone by a fluent non-native Uzbek user, plus standard native phrasings. Register: imperative app-command, lowercase, no punctuation, abbreviations, speech-to-text artifacts. The single most important non-native item is 'outcome' meaning 'expense/outgoing' (mirror of 'income').",
  "magnitude_words": [
    {
      "surface": "k",
      "multiplier": 1000,
      "notes": "suffix, no space: 50k. Also written with a space: 50 k. Most common magnitude token in this corpus."
    },
    {
      "surface": "K",
      "multiplier": 1000,
      "notes": "uppercase variant, 50K"
    },
    {
      "surface": "thousand",
      "multiplier": 1000,
      "notes": "spelled out, usually after a number word: twelve thousand"
    },
    {
      "surface": "grand",
      "multiplier": 1000,
      "notes": "native slang, '1 grand', 'a grand'. Bare 'grand' with no currency word must still leave currency null."
    },
    {
      "surface": "m",
      "multiplier": 1000000,
      "notes": "ambiguous single letter, '3m'. Never treat as metres in this domain."
    },
    {
      "surface": "mn",
      "multiplier": 1000000,
      "notes": "'1 mn', very common typed abbreviation for million among UZ users"
    },
    {
      "surface": "mln",
      "multiplier": 1000000,
      "notes": "'3 mln', abbreviation copied from Russian/Uzbek usage"
    },
    {
      "surface": "mil",
      "multiplier": 1000000,
      "notes": "'2 mil'"
    },
    {
      "surface": "million",
      "multiplier": 1000000,
      "notes": "spelled out; UZS amounts are routinely in millions"
    },
    {
      "surface": "millon",
      "multiplier": 1000000,
      "notes": "common misspelling"
    },
    {
      "surface": "milion",
      "multiplier": 1000000,
      "notes": "common misspelling"
    },
    {
      "surface": "bn",
      "multiplier": 1000000000,
      "notes": "rare, almost never a real personal expense; treat as suspicious"
    },
    {
      "surface": "billion",
      "multiplier": 1000000000,
      "notes": "rare in personal finance, likely a joke or an error"
    },
    {
      "surface": "half a million",
      "multiplier": 500000,
      "notes": "fixed phrase, resolves to 500000 with no separate number token"
    },
    {
      "surface": "one and half",
      "multiplier": 1.5,
      "notes": "non-native form of 'one and a half'; combines with a magnitude word: 'one and half million' = 1500000"
    },
    {
      "surface": "and half",
      "multiplier": 0.5,
      "notes": "additive fragment: 'two and half million' = 2500000"
    }
  ],
