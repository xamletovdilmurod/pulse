{
  "language": "uz",
  "scripts": ["latin", "cyrillic"],
  "notes": "Uzbek as actually spoken/typed in Tashkent. Latin is the official script but Cyrillic is still typed constantly (older users, older keyboards, Telegram habits). Apostrophes in Latin (o', g') are frequently typed as a straight quote ', a backtick `, a curly ’, or dropped entirely (so'm -> som -> sum). The parser MUST normalise all four forms to one before lookup. Uzbek is agglutinative: every surface below can appear with case suffixes glued on, so match by PREFIX after stripping the suffix set in `suffixes`.",
  "suffixes": [
    {"surface": "-ga", "role": "dative", "example": "taksiga = to the taxi, kafega, benzinga, Beelinega", "notes": "also attaches to AMOUNTS: '40 mingga oldim' = bought for 40 thousand. Voicing/assimilation variants: -qa, -ka (bozorga, tashkentga, ishga; but 'oshxonaga')."},
    {"surface": "-da", "role": "locative", "example": "kafeda, restoranda, korzinkada, bozorda", "notes": "'-da' means AT/IN. 'korzinkada 90 ming' = spent 90k at Korzinka."},
    {"surface": "-dan", "role": "ablative", "example": "korzinkadan, bozordan, dorixonadan, kartadan", "notes": "FROM. Most common merchant marker: '<merchant>dan <amount>' is the single most frequent expense pattern. Variant -tan after voiceless stems (Makrotan is rare, Makrodan is normal)."},
    {"surface": "-ni", "role": "accusative", "example": "go'shtni, pulni, kontraktni", "notes": "often dropped in speech."},
    {"surface": "-lik", "role": "worth-of / denomination", "example": "20 minglik, 50 minglik, 100 dollarlik", "notes": "TRAP: '20 minglik non' = 20 thousand's WORTH of bread (amount 20000), but '20 minglik pul' can mean a 20k banknote."},
    {"surface": "-cha", "role": "approximative", "example": "50 mingcha, 100 dollarcha", "notes": "'about/around'. Amount is approximate -> lower confidence."},
    {"surface": "-im / -m", "role": "1sg possessive", "example": "oyligim, maoshim, pulim", "notes": "oylik + im = my salary. Strong income marker."},
    {"surface": "-ning", "role": "genitive", "example": "uyning puli, bolamning kiyimi"},
    {"surface": "-lar", "role": "plural", "example": "bolalarga, mahsulotlar"},
    {"surface": "-siz / -sez", "role": "2pl", "example": "to'ladingiz", "notes": "rare in self-logging"},
    {"surface": "-ta", "role": "numeral classifier", "example": "3 ta non, 2 ta burger", "notes": "CRITICAL TRAP: the number before -ta is a COUNT, never a price. '3 ta non 6 ming' -> amount 6000, quantity 3."},
    {"surface": "-gacha", "role": "terminative", "example": "oyoxirigacha", "notes": "'until' — usually not amount-bearing"}
  ],
